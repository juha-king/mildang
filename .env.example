# true = 시연용 데이터 (백엔드 서버 없어도 동작), false = 실제 FastAPI 요청
VITE_USE_MOCK=true

# 실제 백엔드 연결 시 주소
VITE_API_BASE_URL=http://localhost:8001

# 선택 사항: osm (기본) 또는 kakao
VITE_MAP_PROVIDER=osm

# 카카오맵을 사용하는 경우 JavaScript 키만 설정하세요.
# 이 값은 브라우저에 노출됩니다. 카카오 개발자 콘솔에서 웹 도메인을 제한하세요.
# GPT / 카카오 REST 비밀키는 이곳에 넣지 말고 백엔드에서 관리하세요.
VITE_KAKAO_MAP_JS_KEY=
